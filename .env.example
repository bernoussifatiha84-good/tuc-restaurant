# Valeurs réservées au WordPress/Docker local. Ne jamais réutiliser en UAT ou production.
TUC_WP_IMAGE=wordpress:php8.2-apache
TUC_WP_CLI_IMAGE=wordpress:cli-php8.2
TUC_DB_IMAGE=mariadb:10.11
TUC_WP_PORT=8080
TUC_DB_NAME=tuc_local
TUC_DB_USER=tuc_local
TUC_DB_PASSWORD=REMPLACER_PAR_UN_SECRET_LOCAL
TUC_DB_ROOT_PASSWORD=REMPLACER_PAR_UN_AUTRE_SECRET_LOCAL
# Secrets de test locaux uniquement; renouveler avant toute intégration réelle.
TUC_WA_SECRET=REMPLACER_PAR_UN_SECRET_WEBHOOK_LOCAL
TUC_N8N_INBOUND_SECRET=REMPLACER_PAR_UN_SECRET_ENTRANT_LOCAL
TUC_N8N_POLL_SECRET=REMPLACER_PAR_UN_SECRET_POLL_LOCAL
N8N_ENCRYPTION_KEY=REMPLACER_PAR_UNE_CLE_N8N_LOCALE_D_AU_MOINS_32_CARACTERES
TUC_N8N_IMAGE=n8nio/n8n:2.46.6
TUC_N8N_PORT=5678
